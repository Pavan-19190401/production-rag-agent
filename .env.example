# ==============================================================================
# Environment Configuration - Production RAG System
# ==============================================================================

# LLM Providers (Set at least one)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Model Configuration
LLM_PROVIDER=openai # Options: openai, gemini, mock
LLM_MODEL=gpt-4o-mini
FALLBACK_LLM_MODEL=gpt-3.5-turbo
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

# Vector Database (Qdrant)
# For local prototyping: ':memory:' or './qdrant_data'
# For local Docker: 'http://localhost:6333'
# For Qdrant Cloud: 'https://xxxxxx-xxxx.us-east.aws.cloud.qdrant.io:6333'
QDRANT_URL=./qdrant_data
QDRANT_API_KEY=
QDRANT_COLLECTION=production_rag

# Cache (Redis / Upstash)
# For local Docker: 'redis://localhost:6379/0'
# Leave blank to use in-memory LRU cache
REDIS_URL=

# Application Security & Auth
API_KEY=rag-prod-secret-key-change-me
RATE_LIMIT_PER_MINUTE=60
DAILY_BUDGET_USD=5.00
MAX_TOKENS_PER_QUERY=1024

# Observability (Langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Ingestion & Chunking Defaults
CHUNK_SIZE=512
CHUNK_OVERLAP=50
CHUNK_STRATEGY=recursive # Options: fixed, recursive, heading
